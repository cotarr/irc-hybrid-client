{
  "name": "irc-hybrid-client",
  "version": "2.2.11",
  "description": "Single user hybrid IRC client using JavaScript front end and Node/Express backend",
  "type": "module",
  "main": "bin/www.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npx eslint source-files/js/*.js source-files/web-components/*.js server/testws/html/*.js server/*/*.mjs server/*.mjs bin/www.mjs tools/*.mjs",
    "spell": "npx cspell cspell bin docs server source-files README.md",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node bin/www.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cotarr/irc-hybrid-client.git"
  },
  "author": "cotarr@yahoo.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cotarr/irc-hybrid-client/issues"
  },
  "homepage": "https://github.com/cotarr/irc-hybrid-client#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-redis": "^10.0.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cookie-signature": "^1.2.2",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "memorystore": "^1.6.8",
    "morgan": "^1.12.1",
    "redis": "^6.3.1",
    "rotating-file-stream": "^3.2.10",
    "socks5-client": "^1.2.8",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "cspell": "^10.3.0",
    "eslint": "^10.4.0",
    "globals": "^17.7.0"
  },
  "allowScripts": {
    "utf-8-validate@6.0.6": true
  }
}
